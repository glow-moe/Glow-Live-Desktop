1 ICON "icon.ico"

// Version resource. Windows reads Publisher / Name in the firewall alert, Task
// Manager and the file's Properties tab from here, not from the Authenticode
// signature; without it the alert says "Publisher: Unknown" even on a signed
// build. Regenerate the .syso after editing (see README, "Windows resources").
1 VERSIONINFO
FILEVERSION     26,6,0,0
PRODUCTVERSION  26,6,0,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "SplitFlux LLC"
      VALUE "FileDescription",  "glow L!VE"
      VALUE "FileVersion",      "26.6"
      VALUE "InternalName",     "glow-live"
      VALUE "LegalCopyright",   "Copyright 2026 SplitFlux LLC. MPL-2.0."
      VALUE "OriginalFilename", "glow-live-windows-x64.exe"
      VALUE "ProductName",      "glow L!VE"
      VALUE "ProductVersion",   "26.6"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
